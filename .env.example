# ==============================================================================
# KONFIGURASI ENVIRONMENT DASHBOARD LAB AI UMPO
# Simpan file ini sebagai .env di direktori:
# /home/public/web/panel-lab/.env (atau di root folder proyek)
# ==============================================================================

# 1. PIN Master Super Admin (Ganti dengan kombinasi PIN aman Anda)
ADMIN_PIN=123456

# 2. Path Database SQLite Bersama (JupyterHub & Dashboard API)
# Default jika kosong: /home/public/web/data/lab_users.db
LAB_DB_PATH=/home/public/web/data/lab_users.db

# 3. Path Direktori Static Build Frontend
# Default jika kosong: /home/public/web/panel-lab/frontend/dist
# FRONTEND_DIST=/home/public/web/panel-lab/frontend/dist

# 4. Konfigurasi PostgreSQL (Opsional, jika menggunakan PostgreSQL alih-alih SQLite)
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lab_ai_umpo
