# ==============================================================================
# KONFIGURASI ENVIRONMENT DASHBOARD LAB AI UMPO
# Simpan file ini sebagai .env di direktori:
# /home/public/web/panel-lab/.env (atau di root folder proyek)
# ==============================================================================

# 1. PIN Master Super Admin
# JANGAN pakai nilai contoh. Buat PIN acak minimal 16 karakter, contoh:
# python3 -c "import secrets; print(secrets.token_urlsafe(18))"
ADMIN_PIN=ganti-dengan-pin-acak-anda

# 2. Path Database SQLite Bersama (JupyterHub & Dashboard API)
# Default jika kosong: /home/public/web/data/lab_users.db
LAB_DB_PATH=/home/public/web/data/lab_users.db

# 3. Path Direktori Static Build Frontend
# Default jika kosong: /home/public/web/panel-lab/frontend/dist
# FRONTEND_DIST=/home/public/web/panel-lab/frontend/dist

# 4. Konfigurasi PostgreSQL (Opsional, jika menggunakan PostgreSQL alih-alih SQLite)
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=lab_ai_umpo

# 5. Token internal telemetri JupyterLab (minimal 32 karakter)
# Dipakai dashboard dan proxy JupyterHub di host yang sama. Harus sama nilainya
# dengan EnvironmentFile=/etc/panel-lab/internal.env pada kedua service.
# LAB_INTERNAL_TOKEN=

# 6. Proxy tepercaya untuk header X-Forwarded-For / CF-Connecting-IP
# Hanya IP di daftar ini yang boleh menentukan IP klien pada rate limit login.
# Biarkan default bila dashboard diakses langsung tanpa reverse proxy.
# TRUSTED_PROXIES=127.0.0.1,::1
